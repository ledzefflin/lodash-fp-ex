{
  "name": "lodash-fp-ex",
  "version": "1.1.42",
  "description": "lodash/fp extensions",
  "keywords": [
    "lodash",
    "lodash-extensions",
    "lodash-fp",
    "lodash/fp",
    "lodashFp",
    "fp"
  ],
  "homepage": "https://github.com/ledzefflin/lodash-fp-ex",
  "bugs": {
    "url": "https://github.com/ledzefflin/lodash-fp-ex/issues",
    "email": "ledzefflin@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ledzefflin/lodash-fp-ex"
  },
  "license": "MIT",
  "author": "ledzefflin <ledzefflin@gmail.com>",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "/dist",
    "README.en.md"
  ],
  "scripts": {
    "build": "vp pack",
    "package:install": "pnpm i",
    "re": "rimraf ./node_modules pnpm-lock.yaml && pnpm i",
    "test": "vp test run",
    "u": "pnpm up --interactive --latest",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm test",
    "clean": "rimraf ./node_modules dist",
    "test:watch": "vp test watch",
    "bench": "vp pack && node bench/run.mjs",
    "bench:clone": "node bench/clone.mjs"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.15",
    "lodash": "^4.17.21",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vite-plus": "^1.7.0"
  },
  "peerDependencies": {
    "lodash": "^4.17.21"
  },
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=10"
  }
}
