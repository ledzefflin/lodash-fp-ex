{
  "name": "lodash-fp-ex",
  "version": "1.1.42",
  "description": "lodash/fp extensions",
  "keywords": [
    "lodash",
    "lodash-extensions",
    "lodash-fp",
    "lodash/fp",
    "lodashFp",
    "fp"
  ],
  "homepage": "https://github.com/ledzefflin/lodash-fp-ex",
  "bugs": {
    "url": "https://github.com/ledzefflin/lodash-fp-ex/issues",
    "email": "ledzefflin@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ledzefflin/lodash-fp-ex"
  },
  "license": "MIT",
  "author": "ledzefflin <ledzefflin@gmail.com>",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "vp pack",
    "package:install": "pnpm i && sort-package-json",
    "re": "rimraf ./node_modules && rimraf pnpm-lock.yaml && rimraf package-lock.json && rimraf yarn.lock && pnpm i",
    "test": "vp pack && mocha --reporter spec --require @babel/register",
    "u": "npm-upgrade && pnpm run package:install",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm test",
    "clean": "rimraf ./node_modules dist"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "@babel/register": "^7.25.9",
    "@types/babel__preset-env": "^7.10.0",
    "@types/chai": "^4.3.6",
    "@types/lodash": "^4.17.15",
    "@types/mocha": "^10.0.10",
    "chai": "^4.3.8",
    "lodash": "^4.17.21",
    "mocha": "^10.8.2",
    "npm-upgrade": "^3.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vite-plus": "^1.7.0"
  },
  "peerDependencies": {
    "lodash": "^4.17.21"
  },
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
